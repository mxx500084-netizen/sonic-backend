PORT=8000
# Generate your own with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed origins, leave empty/"*" to allow all
CORS_ORIGIN=

# MongoDB Connection String (MongoDB Atlas or local)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/sonic_food_app?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/sonic_food_app?retryWrites=true&w=majority

